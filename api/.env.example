# Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=True

# Contextual Translation Engine (Universal OpenAI-Compatible)
# Supports: OpenAI, Groq, OpenRouter, DeepSeek, Ollama, vLLM, etc.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
DEFAULT_TARGET_LANG=id
LLM_TIMEOUT_SECONDS=30.0

# --- Provider Examples ---
# 1. Official OpenAI:
#    LLM_BASE_URL=https://api.openai.com/v1
#    LLM_MODEL=gpt-4o-mini
#
# 2. OpenRouter:
#    LLM_BASE_URL=https://openrouter.ai/api/v1
#    LLM_MODEL=google/gemini-2.0-flash-001  (or meta-llama/llama-3.3-70b-instruct)
#
# 3. Groq (High Speed):
#    LLM_BASE_URL=https://api.groq.com/openai/v1
#    LLM_MODEL=llama-3.3-70b-versatile
#
# 4. DeepSeek:
#    LLM_BASE_URL=https://api.deepseek.com/v1
#    LLM_MODEL=deepseek-chat
#
# 5. Local Ollama:
#    LLM_BASE_URL=http://localhost:11434/v1
#    LLM_API_KEY=ollama
#    LLM_MODEL=qwen2.5:7b
