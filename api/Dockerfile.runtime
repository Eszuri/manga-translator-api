# syntax=docker/dockerfile:1.7
# Build this image only for the first setup or when Docker dependencies change.
FROM python:3.11-slim-bookworm AS gpu-runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HF_HOME=/home/translator/.cache/huggingface
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 translator \
    && useradd --uid 10001 --gid translator --create-home translator

COPY requirements/base.txt requirements/docker.txt ./requirements/
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install -r requirements/docker.txt

# Keep BuildKit's package cache. Do not purge it: CUDA/cuDNN wheels are large
# and should only be downloaded again when their version changes.
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip install --default-timeout=1800 --retries=10 \
        "onnxruntime-gpu[cuda,cudnn]==1.26.0"

RUN mkdir -p /home/translator/.cache/huggingface \
    && chown -R translator:translator /home/translator/.cache
